98	row_98	(none)	(none)	(none)	-1
97	row_97	(none)	(none)	(none)	-1

query I
SELECT COUNT(*) FROM (SELECT n FROM TABLE(vgi_example.main.order_echo(10)) ORDER BY n NULLS FIRST)
----
10


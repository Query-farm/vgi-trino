query II
SELECT MIN(n), MAX(n) FROM TABLE(vgi_example.main.filter_echo(100)) WHERE n >= 20 AND n < 80
----
20	79

query I
SELECT COUNT(*) FROM TABLE(vgi_example.main.filter_echo(10000)) WHERE n = 5000
----
